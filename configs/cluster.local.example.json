{
  "schema_version": 2,
  "model": "v41-flash-1017",
  "models": {
    "v41-flash-1017": {
      "hub": "{home}/.cache/huggingface/hub",
      "snapshot": "models--deepseek-ai--DeepSeek-V4.1-Flash-1017/snapshots/<revision>",
      "notes": "DeepSeek-V4.1-Flash-1017, native weights."
    }
  },
  "container": {
    "name": "spark-ds41f",
    "image": "spark-ds41f:<build>",
    "docker_run_args": [
      "--network=host",
      "--ipc=host",
      "--gpus=all",
      "--device=/dev/infiniband:/dev/infiniband:rwm",
      "--cap-add=IPC_LOCK",
      "--ulimit=memlock=-1:-1",
      "--ulimit=stack=67108864:67108864",
      "--security-opt=seccomp=unconfined",
      "--shm-size=16g"
    ]
  },
  "host": {
    "home": "{home}",
    "memguard_gib": 3
  },
  "default_shape": "tp4-ring",
  "shapes": {
    "tp4-ring": {
      "nodes": 4,
      "nodes_config": "config/nodes-ring4.local.json",
      "fabric": { "transport": "oneshot-ring4" },
      "sizing": {
        "max_model_len": 1048576,
        "max_num_seqs": 16,
        "max_num_batched_tokens": 16384,
        "kv_cache_memory_bytes": 11274289152,
        "prefix_cache_retention_interval": 8192
      },
      "environment": {
        "NCCL_ALGO": "Ring",
        "NCCL_BUFFSIZE": "4194304",
        "NCCL_COLLNET_ENABLE": "0",
        "NCCL_CROSS_NIC": "1",
        "NCCL_CUMEM_ENABLE": "1",
        "NCCL_CUMEM_HOST_ENABLE": "0",
        "NCCL_IB_GID_INDEX": "3"
      }
    }
  }
}
